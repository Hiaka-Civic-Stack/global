{
  "name": "hiaka-civic-stack",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:landing": "pnpm --filter @hiaka/landing dev",
    "dev:specs": "pnpm --filter @hiaka/specs dev",
    "lint": "turbo run lint",
    "seed:landing": "pnpm --filter @hiaka/landing seed:pages",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0"
    }
  }
}
